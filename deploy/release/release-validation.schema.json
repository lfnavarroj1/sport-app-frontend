{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lfnavarroj1/sport-app-frontend/deploy/release/release-validation.schema.json",
  "title": "release-validation.json",
  "description": "Evidencia de la validación de una release que genera release-web.yml en GitHub Actions, sin acceso a GCP. La imagen solo existe en el runner: se identifica por su ID local y no se publica.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repository",
    "component",
    "version",
    "tag",
    "commit",
    "expectedBffContract",
    "localImage",
    "artifact",
    "checks",
    "smokeTest",
    "github",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "release-validation" },
    "repository": { "const": "lfnavarroj1/sport-app-frontend" },
    "component": { "const": "web" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expectedBffContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "const": "bff-web" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "localImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "published"],
      "properties": {
        "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "published": { "const": false }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "source"],
      "properties": {
        "name": { "const": "web.tgz" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "const": "/usr/share/nginx/html" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" }
        }
      }
    },
    "smokeTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "script", "scriptSha256", "checksPassed"],
      "properties": {
        "status": { "const": "passed" },
        "script": { "const": "deploy/docker/smoke-test.sh" },
        "scriptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "checksPassed": { "type": "integer", "minimum": 1 }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "runId", "runUrl"],
      "properties": {
        "workflow": { "const": "release-web" },
        "runId": { "type": "string", "pattern": "^[0-9]+$" },
        "runUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/lfnavarroj1/sport-app-frontend/actions/runs/[0-9]+$"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
