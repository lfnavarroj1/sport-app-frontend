{
  "name": "sport-app-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^24.14.0",
    "npm": ">=11.9.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI --coverage",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:integrated": "playwright test -c playwright.integrated.config.ts",
    "smoke": "playwright test -c playwright.integrated.config.ts --grep @smoke",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "container:build": "docker build -t sportapp/web:local .",
    "precommit": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run e2e:smoke"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "6.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jasmine-core": "6.0.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2"
  }
}
